{
  "name": "fixwire/examples",
  "description": "Real apps using the Fixwire PHP SDK, run against a fake ingest by the tests",
  "type": "project",
  "license": "MIT",
  "require": {
    "php": ">=8.1",
    "fixwire/fixwire": "*@dev",
    "guzzlehttp/guzzle": "^7.9",
    "monolog/monolog": "^3.7",
    "slim/psr7": "^1.7",
    "slim/slim": "^4.14"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5 || ^11.5 || ^12.0"
  },
  "repositories": [{ "type": "path", "url": ".." }],
  "autoload-dev": {
    "psr-4": { "Fixwire\\Examples\\Tests\\": "tests/" }
  },
  "config": { "lock": false }
}
